{
  "name": "mini-plots",
  "version": "0.1.0",
  "description": "A tiny dependency-free-at-runtime SVG scatter and line plotting library.",
  "type": "module",
  "main": "./dist/mini-plots.js",
  "module": "./dist/mini-plots.js",
  "exports": {
    ".": "./dist/mini-plots.js"
  },
  "files": [
    "dist/mini-plots.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:demo": "npm run build:lib && vite build --config vite.demo.config.js && node scripts/prepare-site.js",
    "build": "npm run build:demo && npm run verify:build",
    "verify:build": "node scripts/verify-build.js",
    "preview": "vite preview --config vite.demo.config.js"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "plot",
    "scatter",
    "line-chart",
    "svg",
    "csv"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^27.0.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
